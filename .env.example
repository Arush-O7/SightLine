# Copy to .env and fill in what you need. Everything here is optional;
# with nothing set the site runs on SQLite with demo tools on.

# Port for the production server (npm start)
PORT=8787

# The site's public address, used in email links and for Google sign-in.
# Leave empty in development; set it in production, e.g. https://tickets.example.com
PUBLIC_URL=

# ---------------------------------------------------------------- database
# PostgreSQL. When set, it is used instead of SQLite. Works with Neon, Supabase,
# Railway, RDS or your own server. Tables are created on first start.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
# TLS is used for hosted databases and skipped for localhost. Force with 1, turn off with 0.
DATABASE_SSL=
# Connections per server process (default 10)
DATABASE_POOL_MAX=

# SQLite file, used when DATABASE_URL is empty
SIGHTLINE_DB=data/sightline.db

# ------------------------------------------------------- Sign in with Google
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:5173/api/auth/google/callback      (npm run dev)
#   http://localhost:8787/api/auth/google/callback      (npm start)
#   <PUBLIC_URL>/api/auth/google/callback               (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------ movie posters
# Official posters and backdrops from The Movie Database. Get a free key at
# https://www.themoviedb.org/settings/api and set ONE of these. Without it the
# site shows its own designed posters.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# ------------------------------------------------------------------- staff
# Accounts with these emails (comma-separated) can open /admin. Admins can also
# promote other accounts from Admin -> Customers.
ADMIN_EMAILS=

# ------------------------------------------------------------------- email
# Leave SMTP_HOST empty to keep emails in the demo inbox only.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<an app password, not your normal password>, MAIL_FROM="SightLine <you@gmail.com>"
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<a sending-access API key>,
# MAIL_FROM="SightLine <onboarding@resend.dev>" until a domain is verified (that sender reaches only your own address)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# -------------------------------------------------------------------- misc
# Demo tools: Demo Inbox, one-click demo account, reset. Visitors from other machines only see
# emails to reserved addresses (name@example.com, *.test) in the inbox. Set to 0 to remove them all.
SIGHTLINE_DEMO=1
# One log line per API request in production (0 to turn off)
LOG_REQUESTS=1
# Set to 1 only when the server runs behind your own reverse proxy (nginx, Caddy, a load balancer),
# so rate limits count each visitor by the address the proxy records instead of the proxy's own.
# Leave it empty on Vercel, which is handled automatically, and when nothing sits in front of the server.
TRUST_PROXY=
